# oxo-flow-atacseq — port of nf-core/atacseq v2.1.2
#
# Default path: single-end, BWA aligner, broad-peak MACS2 (upstream
# defaults). Gated branches (all off by default so the default plan is
# unchanged; see README "Known divergences" and each gate):
#   config.paired=true                  paired-end reads (PE rule set in modules/paired.oxoflow)
#   config.aligner=bowtie2|chromap|star alternative aligners (modules/aligners.oxoflow)
#   config.prepare_reference=true       build BWA index + chrom sizes (modules/reference.oxoflow)
#   config.macs_gsize=""                auto-estimate genome size with khmer at config.read_length (modules/reference.oxoflow)
#   config.mito_name / raw_blacklist    mitochondrial filtering (modules/mito_filter.oxoflow)
#   config.skip_consensus_peaks=false   consensus peaks/DESeq2 (modules/consensus.oxoflow)
#   config.skip_preseq=false            preseq complexity extrapolation
#   config.skip_picard_metrics=false    Picard CollectMultipleMetrics
#   config.skip_ataqv=false             ATAQV + mkarv reports
#   config.skip_peak_qc=false           MACS2/HOMER R QC plots
#   config.multiqc_custom_peaks=true    MultiQC peak-count/FRiP TSVs
#   config.skip_igv=false               IGV session
# Fidelity notes for every upstream process live in README.md; items that are
# not ported are listed there with reasons and in metadata.json `excluded`.

[workflow]
name = "oxo-flow-atacseq"
version = "2.1.2"
description = "ATAC-seq peak calling and QC — FastQC → Trim Galore → BWA-MEM → markdup/filter → MACS2 → QC plots → MultiQC (port of nf-core/atacseq 2.1.2)"
author = "oxo-flow-community"

[config]
# Reference inputs. Upstream obtains these from nf-core iGenomes (--genome);
# this port expects pre-built files (see README "References").
reference = "test/fixtures/genome/genome.fa"          # params.fasta
bwa_index = "test/fixtures/genome/genome.fa"          # params.bwa — index prefix (.amb/.ann/.bwt/.pac/.sa beside it)
gtf = "test/fixtures/genome/genes.gtf"                # params.gtf
gene_bed = "test/fixtures/genome/gene.bed"            # params.gene_bed
tss_bed = "test/fixtures/genome/tss.bed"              # params.tss_bed
chrom_sizes = "test/fixtures/genome/genome.fa.sizes"  # CUSTOM_GETCHROMSIZES output
blacklist = ""                                        # params.blacklist — include-regions BED (complement of ENCODE
                                                      # blacklist + chrM when keep_mito=false); empty = no -L filter
macs_gsize = "2.7e9"                                  # params.genomes[...].macs_gsize (read-length keyed, e.g. GRCh37/38 @50bp); "" = auto-estimate via khmer at config.read_length (upstream KHMER_UNIQUEKMERS)
read_length = 50                                      # params.read_length — khmer k-mer size for the macs_gsize auto-estimate
out_dir = "results"                                   # params.outdir
raw_dir = "test/fixtures/raw"                         # input fastqs (raw/<sample>.fastq.gz for single-end)
# GB passed to picard -Xmx. Previously derived from the rule's 36G
# resource budget (Xmx≈30G), which thrash-killed the JVM on a 3.7 GB
# machine (live run); the resource budget still drives scheduling.
picard_xmx_gb = 8
# Upstream default params (kept as config so CLI overrides work)
narrow_peak = false
broad_cutoff = 0.1
fragment_size = 200
fingerprint_bins = 500000
min_trimmed_reads = 10000
keep_dups = false
keep_multi_map = false
save_trimmed = false
skip_fastqc = false
skip_qc = false
skip_trimming = false
skip_plot_profile = false
skip_plot_fingerprint = false
skip_multiqc = false
# ---------------------------------------------------------------------------
# Gated branches (defaults keep the default plan identical to the upstream
# default main path; toggle one key at a time to activate its branch only)
# ---------------------------------------------------------------------------
paired = false                # false = single-end reads (upstream default); true = paired-end
aligner = "bwa"               # params.aligner: "bwa" (default) | "bowtie2" | "chromap" | "star" (SE only)
prepare_reference = false     # port switch: build BWA index + chrom sizes from config.reference
raw_blacklist = ""            # params.blacklist — raw ENCODE blacklist BED (complemented into include-regions)
mito_name = ""                # params.mito_name, e.g. "chrM" — enables mitochondrial filtering (needs config.chrom_sizes)
keep_mito = false             # params.keep_mito — keep mitochondrial reads when mito_name set
bowtie2_index = ""            # params.bowtie2 — index prefix (.rev.1.bt2 etc. beside it) for aligner="bowtie2"
chromap_index = ""            # params.chromap — index file for aligner="chromap"
star_index = ""               # params.star — STAR genome dir (built by STAR_GENOMEGENERATE upstream) for aligner="star"
skip_preseq = true            # params.skip_preseq (upstream default true — preseq off by default)
skip_picard_metrics = true    # upstream default false; port ships this branch OFF (set false to enable)
skip_ataqv = true             # upstream default false; port ships this branch OFF (set false to enable)
skip_igv = true               # upstream default false; port ships this branch OFF (set false to enable)
skip_consensus_peaks = true   # upstream default false; port ships this branch OFF (set false to enable)
skip_peak_qc = true           # upstream default false; port ships the R QC plots OFF (set false to enable)
skip_deseq2_qc = true         # upstream default false; port ships DESeq2 QC OFF (set false to enable)
skip_peak_annotation = false  # params.skip_peak_annotation (default false — HOMER annotation on by default, as upstream)
min_reps_consensus = 1        # params.min_reps_consensus
deseq2_vst = true             # params.deseq2_vst
multiqc_custom_peaks = false  # port-only switch: emit MULTIQC_CUSTOM_PEAKS peak-count/FRiP TSVs
skip_merge_replicates = false # params.skip_merge_replicates (upstream default false = merged-replicate analysis ON when replicate samples are declared)
merged_samples = ""           # base names of replicate groups (e.g. "S1,S2" for samples S1_REP1/S1_REP2/S2_REP1/S2_REP2) — feeds merged-replicate files into the MultiQC / IGV aggregation rules; empty = no-op

[[sample_groups]]
name = "cohort"
samples = ["S1", "S2"]

# ---------------------------------------------------------------------------
# Gated branch modules (all rules inside are off on the default config)
# ---------------------------------------------------------------------------
[[include]]
path = "modules/paired.oxoflow"
namespace = "pe"

[[include]]
path = "modules/aligners.oxoflow"
namespace = "alt"

[[include]]
path = "modules/reference.oxoflow"
namespace = "ref"

[[include]]
path = "modules/mito_filter.oxoflow"
namespace = "mito"

[[include]]
path = "modules/consensus.oxoflow"
namespace = "cons"

[[include]]
path = "modules/qc_extra.oxoflow"
namespace = "qce"

[[rules]]
name = "fastqc"
input = ["{config.raw_dir}/{sample}.fastq.gz"]
output = [
    "{config.out_dir}/fastqc/{sample}_fastqc.html",
    "{config.out_dir}/fastqc/zips/{sample}_fastqc.zip",
]
description = "FASTQC: raw read QC (upstream FASTQC, single-end)"
shell = """
[ ! -f {sample}.fastq.gz ] && ln -s {input[0]} {sample}.fastq.gz
fastqc \\
    --quiet \\
    --threads {threads} \\
    -o {config.out_dir}/fastqc \\
    {sample}.fastq.gz
mv {config.out_dir}/fastqc/{sample}_fastqc.zip {config.out_dir}/fastqc/zips/
"""
when = "!config.paired && !config.skip_fastqc && !config.skip_qc"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/fastqc:0.11.9--0"

[[rules]]
name = "trimgalore"
input = ["{config.raw_dir}/{sample}.fastq.gz"]
output = [
    "{config.out_dir}/trimgalore/{sample}_trimmed.fq.gz",
    "{config.out_dir}/trimgalore/fastqc/{sample}_trimmed_fastqc.html",
    "{config.out_dir}/trimgalore/fastqc/zips/{sample}_trimmed_fastqc.zip",
    "{config.out_dir}/trimgalore/logs/{sample}.fastq.gz_trimming_report.txt",
]
description = "TRIMGALORE: adapter trimming + per-base QC (upstream TRIMGALORE, single-end branch)"
shell = """
[ ! -f {sample}.fastq.gz ] && ln -s {input[0]} {sample}.fastq.gz
trim_galore \\
    --fastqc \\
    --cores 8 \\
    --gzip \\
    {sample}.fastq.gz
mv {sample}_trimmed.fq.gz {config.out_dir}/trimgalore/
mv {sample}_trimmed_fastqc.html {config.out_dir}/trimgalore/fastqc/
mv {sample}_trimmed_fastqc.zip {config.out_dir}/trimgalore/fastqc/zips/
mv {sample}.fastq.gz_trimming_report.txt {config.out_dir}/trimgalore/logs/
"""
when = "!config.paired && !config.skip_trimming"

[rules.resources]
threads = 12
memory = "72G"

[rules.environment]
docker = "quay.io/biocontainers/trim-galore:0.6.7--hdfd78af_0"

[[rules]]
name = "bwa_mem"
input = [
    "{config.out_dir}/trimgalore/{sample}_trimmed.fq.gz",
    "{config.bwa_index}.amb",
    "{config.bwa_index}.ann",
    "{config.bwa_index}.bwt",
    "{config.bwa_index}.pac",
    "{config.bwa_index}.sa",
]
output = ["{config.out_dir}/bwa/library/{sample}.Lb.bam"]
description = "BWA_MEM: align with BWA-MEM and filter secondary alignments (upstream BWA_MEM, single-end)"
shell = """
SM=$(echo {sample} | sed 's/_T[0-9]*$//')
bwa mem \\
    -M \\
    -R '@RG\\tID:{sample}\\tSM:$SM\\tPL:ILLUMINA\\tLB:{sample}\\tPU:1' \\
    -t {threads} \\
    {config.bwa_index} \\
    {input[0]} \\
    | samtools view -bh -F 0x0100 -O BAM -o {config.out_dir}/bwa/library/{sample}.Lb.bam -
"""
when = "!config.paired && config.aligner == 'bwa'"

[rules.resources]
threads = 12
memory = "72G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c272b25e7e642ae3ff0bf0c5c81a5135ab4-0"

[[rules]]
name = "samtools_sort_stats"
input = [
    "{config.out_dir}/bwa/library/{sample}.Lb.bam",
    "{config.reference}",
]
output = [
    "{config.out_dir}/bwa/library/{sample}.Lb.sorted.bam",
    "{config.out_dir}/bwa/library/{sample}.Lb.sorted.bam.bai",
    "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.stats",
    "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.flagstat",
    "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.idxstats",
]
description = "BAM_SORT_STATS_SAMTOOLS: coordinate sort, index, stats, flagstat, idxstats (5 upstream processes folded; same samtools 1.17 env)"
shell = """
samtools sort \\
    -@ {threads} \\
    -o {config.out_dir}/bwa/library/{sample}.Lb.sorted.bam \\
    -T {sample}.Lb.sorted \\
    {config.out_dir}/bwa/library/{sample}.Lb.bam

samtools \\
    index \\
    -@ 5 \\
    {config.out_dir}/bwa/library/{sample}.Lb.sorted.bam

samtools \\
    stats \\
    --threads {threads} \\
    --reference {config.reference} \\
    {config.out_dir}/bwa/library/{sample}.Lb.sorted.bam \\
    > {config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.stats

samtools \\
    flagstat \\
    --threads {threads} \\
    {config.out_dir}/bwa/library/{sample}.Lb.sorted.bam \\
    > {config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.flagstat

samtools idxstats {config.out_dir}/bwa/library/{sample}.Lb.sorted.bam \\
    > {config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.idxstats
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.17--h00cdaf9_0"

[[rules]]
name = "picard_mergesamfiles"
input = ["{config.out_dir}/bwa/library/{sample}.Lb.sorted.bam"]
output = ["{config.out_dir}/bwa/merged_library/{sample}.mLb.sorted.bam"]
description = "PICARD_MERGESAMFILES_LIBRARY: merge resequenced libraries (single-pair samples take the upstream symlink branch)"
# ln -sf (not -s): the engine re-runs this rule in place when a config change
# invalidates it, and the previous run's symlink must be replaced, not error
# ("File exists") — upstream only ever runs on a fresh workdir, so it uses -s.
shell = """
ln -sf "$PWD/{input[0]}" {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
conda = "envs/picard-samtools.yaml"

[[rules]]
name = "picard_markduplicates"
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.sorted.bam",
    "{config.reference}",
    "{config.reference}.fai",
]
output = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam",
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam.bai",
    "{config.out_dir}/bwa/merged_library/picard_metrics/{sample}.mLb.mkD.sorted.MarkDuplicates.metrics.txt",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.stats",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.flagstat",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.idxstats",
]
description = "BAM_MARKDUPLICATES_PICARD: Picard MarkDuplicates + index + stats (upstream 4 processes folded; picard 3.0.0 + samtools 1.17 in one env)"
shell = """
XMX=$(( {config.picard_xmx_gb} * 1024 ))
picard \\
    -Xmx${XMX}M \\
    MarkDuplicates \\
    --ASSUME_SORTED true \\
    --REMOVE_DUPLICATES false \\
    --VALIDATION_STRINGENCY LENIENT \\
    --TMP_DIR tmp \\
    --INPUT {config.out_dir}/bwa/merged_library/{sample}.mLb.sorted.bam \\
    --OUTPUT {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam \\
    --REFERENCE_SEQUENCE {config.reference} \\
    --METRICS_FILE {config.out_dir}/bwa/merged_library/picard_metrics/{sample}.mLb.mkD.sorted.MarkDuplicates.metrics.txt

samtools \\
    index \\
    -@ 5 \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam

samtools \\
    stats \\
    --threads {threads} \\
    --reference {config.reference} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.stats

samtools \\
    flagstat \\
    --threads {threads} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.flagstat

samtools idxstats {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.idxstats
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
conda = "envs/picard-samtools.yaml"

[[rules]]
name = "bamtools_filter"
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam",
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam.bai",
    "assets/bamtools_filter_se.json",
]
output = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam.bai",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats",
]
description = "BAM_FILTER_BAMTOOLS: filter with BAMTools + index + stats (upstream BAMTOOLS_FILTER, SAMTOOLS_INDEX, BAM_STATS_SAMTOOLS folded; single-end branch — no name sort / orphan removal)"
shell = """
BLACKLIST=""
if [ -n "{config.mito_name}" ] || [ -n "{config.raw_blacklist}" ]; then
    BLACKLIST="-L {config.out_dir}/genome/genome.fa.include_regions.bed"
elif [ -n "{config.blacklist}" ]; then
    BLACKLIST="-L {config.blacklist}"
fi
samtools view \\
    -F 0x004 \\
    -F 0x0400 \\
    -q 1 \\
    $BLACKLIST \\
    -b {config.out_dir}/bwa/merged_library/{sample}.mLb.mkD.sorted.bam \\
    | bamtools filter \\
        -out {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
        -script assets/bamtools_filter_se.json

samtools \\
    index \\
    -@ 5 \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam

samtools \\
    stats \\
    --threads {threads} \\
    --reference {config.reference} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats

samtools \\
    flagstat \\
    --threads {threads} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat

samtools idxstats {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats
"""
when = "!config.paired"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-0560a8046fc82aa4338588eca29ff18edab2c5aa:5687a7da26983502d0a8a9a6b05ed727c740ddc4-0"

[[rules]]
name = "merge_replicates"
input_groups = [
    # Folds every per-replicate filtered BAM of one sample into a single
    # instance (the upstream groupTuple on `meta.id - ~/_REP\d+$/`): files
    # matching `{sample}_REP{rep}.mLb.clN.sorted.bam` group by the base
    # sample prefix. One instance per group; groups with no files (no
    # `_REP\d+` samples declared) instantiate nothing, so the default plan
    # is unchanged. The merged BAM lands on the canonical
    # `{sample}.mLb.clN.sorted.bam` path the per-sample chain would have
    # written, so the downstream rules below read one path either way.
    # Deviation vs upstream: 1-replicate groups still produce a merged BAM
    # (upstream keeps them unmerged), and the merged BAM is not re-run
    # through MarkDuplicates (upstream MERGED_REPLICATE_MARKDUPLICATES_PICARD
    # re-marks duplicates on the merged set) — the per-replicate markdup
    # state is retained.
    { pattern = "{config.out_dir}/bwa/merged_library/{sample}_REP{rep}.mLb.clN.sorted.bam", group_by = "sample" },
]
output = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam.bai",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats",
]
description = "PICARD_MERGESAMFILES_REPLICATE: merge per-replicate filtered BAMs into one merged BAM per sample + index + stats (upstream MERGED_REPLICATE_* chain head; replicate groups from the `_REP\\d+$` sample-suffix convention)"
shell = """
XMX=$(( {config.picard_xmx_gb} * 1024 ))
# {input} is the space-joined group file list; turn it into repeated
# --INPUT flags (paths in this port contain no spaces). Engines without
# input_groups support (released builds before Traitome/oxo-flow#231)
# cannot populate {input} — fail fast instead of feeding picard an empty
# --INPUT list.
if [ -z "$(printf '%s' "{input}" | tr -d '[:space:]')" ]; then
    echo "merge_replicates: no per-replicate BAMs for '{sample}' — this engine build has no input_groups support (Traitome/oxo-flow#231); upgrade oxo-flow" >&2
    exit 1
fi
INPUT_FLAGS=""
for bam in {input}; do INPUT_FLAGS="$INPUT_FLAGS --INPUT $bam"; done
picard \\
    -Xmx${XMX}M \\
    MergeSamFiles \\
    --SORT_ORDER coordinate \\
    --VALIDATION_STRINGENCY LENIENT \\
    --TMP_DIR tmp \\
    $INPUT_FLAGS \\
    --OUTPUT {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam

samtools \\
    index \\
    -@ 5 \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam

samtools \\
    stats \\
    --threads {threads} \\
    --reference {config.reference} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats

samtools \\
    flagstat \\
    --threads {threads} \\
    {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat

samtools idxstats {config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam \\
    > {config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats
"""
when = "!config.skip_merge_replicates && config.merged_samples != ''"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
conda = "envs/picard-samtools.yaml"

[[rules]]
name = "macs2_callpeak"
# One instance per filtered BAM present — the per-sample chain's
# `bamtools_filter` outputs AND the `merge_replicates` merged BAMs, so
# per-replicate and merged-replicate peak sets are both produced (upstream
# MERGED_REPLICATE_CALL_ANNOTATE_PEAKS runs the same macs2 command on the
# merged BAMs). On the default path (no `_REP\d+` samples) the instances
# are exactly the per-sample ones.
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "sample" },
]
# Declared input (baseline): engines without input_groups support fall
# back to this list and run the per-sample chain unchanged. On input_groups
# engines the group file (the same path) leads {input}, so {input[0]} is
# the filtered BAM either way.
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
]
# khmer auto-estimate (config.macs_gsize = "") — when-gated producer; a closed
# gate counts as satisfied for dependents, so this is safe on the default path.
depends_on = ["ref::khmer_uniquekmers"]
output = [
    "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak",
    "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.gappedPeak",
    "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.xls",
]
description = "MACS2_CALLPEAK: call peaks with MACS2 (broad-peak default, no control, single-end BAM)"
shell = """
# config.macs_gsize = "" routes the genome size through the khmer estimate
# (ref::khmer_uniquekmers); a fixed value is used as-is (upstream
# `if (!params.macs_gsize)` wiring).
if [ -n "{config.macs_gsize}" ]; then
    GSIZE="{config.macs_gsize}"
else
    GSIZE=$(cat {config.out_dir}/genome/kmers.txt)
fi

macs2 \\
    callpeak \\
    --keep-dup all \\
    --nomodel \\
    --broad \\
    --broad-cutoff {config.broad_cutoff} \\
    --gsize $GSIZE \\
    --format BAM \\
    --name {sample}.mLb.clN \\
    --treatment {input[0]}

mv {sample}.mLb.clN_peaks.broadPeak {config.out_dir}/bwa/merged_library/macs2/broad_peak/
mv {sample}.mLb.clN_peaks.gappedPeak {config.out_dir}/bwa/merged_library/macs2/broad_peak/
mv {sample}.mLb.clN_peaks.xls {config.out_dir}/bwa/merged_library/macs2/broad_peak/
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/macs2:2.2.7.1--py38h4a8c8d9_3"

[[rules]]
name = "homer_annotatepeaks"
# One instance per peak set present (per-replicate and merged-replicate).
# Group files render first in {input}: {input[0]} is the peaks file, the
# declared reference/gtf inputs append after.
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak", group_by = "sample" },
]
# The peaks file is also declared so engines without input_groups support
# run the per-sample chain unchanged (there it is {input[0]} directly).
input = [
    "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak",
    "{config.reference}",
    "{config.gtf}",
]
output = ["{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.annotatePeaks.txt"]
description = "HOMER_ANNOTATEPEAKS: annotate peaks with HOMER"
shell = """
annotatePeaks.pl \\
    {input[0]} \\
    {config.reference} \\
    -gid \\
    -gtf {config.gtf} \\
    -cpu {threads} \\
    > {output[0]}
"""
when = "!config.skip_peak_annotation"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/homer:4.11--pl526hc9558a2_3"

[[rules]]
name = "frip_score"
# One instance per BAM present (per-replicate and merged-replicate);
# the per-sample peak set is the trailing declared input — on input_groups
# engines the group file (the same BAM) leads {input}, so {input[0]} is
# the BAM and the peak set is the last entry either way; on engines
# without input_groups support the declared inputs run the per-sample
# chain unchanged.
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "sample" },
]
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
    "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak",
]
output = ["{config.out_dir}/bwa/merged_library/macs2/broad_peak/qc/{sample}.FRiP.txt"]
description = "FRIP_SCORE: fraction of reads in peaks (feeds the excluded MULTIQC_CUSTOM_PEAKS upstream; kept as the pipeline runs it on the default path)"
shell = """
READS_IN_PEAKS=$(intersectBed -a {input[0]} -b $(printf '%s\\n' {input} | tail -1) -bed -c -f 0.20 | awk -F '\\t' '{sum += $NF} END {print sum}')
samtools flagstat {input[0]} > {input[0]}.flagstat
grep 'mapped (' {input[0]}.flagstat | grep -v "primary" | awk -v a="$READS_IN_PEAKS" -v OFS='\\t' '{print "{sample}", a/$1}' > {output[0]}
"""

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-8186960447c5cb2faa697666dc1e6d919ad23f3e:3127fcae6b6bdaf8181e21a26ae61231030a9fcb-0"

[[rules]]
name = "bedtools_genomecov"
# One instance per BAM present (per-replicate and merged-replicate);
# the per-sample flagstat is the trailing declared input — on input_groups
# engines the group file (the same BAM) leads {input}, so {input[0]} is
# the BAM and the flagstat is the last entry either way; on engines
# without input_groups support the declared inputs run the per-sample
# chain unchanged.
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "sample" },
]
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
    "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat",
]
output = [
    "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bedGraph",
    "{config.out_dir}/bwa/merged_library/bigwig/scale/{sample}.mLb.clN.scale_factor.txt",
]
description = "BEDTOOLS_GENOMECOV: 1e6-read-normalised bedGraph track (single-end: -fs fragment_size, no -pc)"
shell = """
SCALE_FACTOR=$(grep '[0-9] mapped (' $(printf '%s\\n' {input} | tail -1) | awk '{print 1000000/$1}')
echo $SCALE_FACTOR > {config.out_dir}/bwa/merged_library/bigwig/scale/{sample}.mLb.clN.scale_factor.txt

bedtools \\
    genomecov \\
    -ibam {input[0]} \\
    -bg \\
    -scale $SCALE_FACTOR \\
    -fs {config.fragment_size} \\
> tmp.bg

bedtools sort -i tmp.bg > {config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bedGraph
"""
when = "!config.paired"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/bedtools:2.30.0--hc088bd4_0"

[[rules]]
name = "ucsc_bedgraphtobigwig"
# One instance per bedGraph present (per-replicate and merged-replicate).
# The bedGraph is also declared so engines without input_groups support
# run the per-sample chain unchanged ({input[0]} either way).
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bedGraph", group_by = "sample" },
]
input = [
    "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bedGraph",
    "{config.chrom_sizes}",
]
output = ["{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bigWig"]
description = "UCSC_BEDGRAPHTOBIGWIG: convert normalised bedGraph to bigWig"
shell = """
bedGraphToBigWig \\
    {input[0]} \\
    {config.chrom_sizes} \\
    {output[0]}
"""

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/ucsc-bedgraphtobigwig:445--h954228d_0"

[[rules]]
name = "deeptools_plots"
# One instance per bigWig present (per-replicate and merged-replicate).
# The bigWig is also declared so engines without input_groups support run
# the per-sample chain unchanged ({input[0]} either way).
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bigWig", group_by = "sample" },
]
input = [
    "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bigWig",
    "{config.gene_bed}",
    "{config.tss_bed}",
]
output = [
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.computeMatrix.mat.gz",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.computeMatrix.vals.mat.tab",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.computeMatrix.mat.gz",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.computeMatrix.vals.mat.tab",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.pdf",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.tab",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.plotHeatmap.pdf",
    "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.plotHeatmap.mat.tab",
]
description = "BIGWIG_PLOT_DEEPTOOLS: computeMatrix (scale-regions + reference-point), plotProfile, plotHeatmap (upstream 4 processes folded; same deeptools 3.5.1 env)"
shell = """
computeMatrix \\
    scale-regions \\
    --regionsFileName {config.gene_bed} \\
    --scoreFileName {input[0]} \\
    --outFileName {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.computeMatrix.mat.gz \\
    --outFileNameMatrix {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.computeMatrix.vals.mat.tab \\
    --numberOfProcessors {threads} \\
    --regionBodyLength 1000 \\
    --beforeRegionStartLength 3000 \\
    --afterRegionStartLength 3000 \\
    --missingDataAsZero \\
    --skipZeros \\
    --smartLabels

computeMatrix \\
    reference-point \\
    --regionsFileName {config.tss_bed} \\
    --scoreFileName {input[0]} \\
    --outFileName {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.computeMatrix.mat.gz \\
    --outFileNameMatrix {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.computeMatrix.vals.mat.tab \\
    --numberOfProcessors {threads} \\
    --missingDataAsZero \\
    --skipZeros \\
    --smartLabels \\
    --upstream 3000 \\
    --downstream 3000

plotProfile \\
    --matrixFile {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.computeMatrix.mat.gz \\
    --outFileName {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.pdf \\
    --outFileNameData {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.tab

plotHeatmap \\
    --matrixFile {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.computeMatrix.mat.gz \\
    --outFileName {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.plotHeatmap.pdf \\
    --outFileNameMatrix {config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.scale_regions.plotHeatmap.mat.tab
"""
when = "!config.skip_plot_profile"

[rules.resources]
threads = 12
memory = "72G"

[rules.environment]
docker = "quay.io/biocontainers/deeptools:3.5.1--py_0"

[[rules]]
name = "plotfingerprint"
# One instance per BAM present (per-replicate and merged-replicate);
# the BAM is also declared so engines without input_groups support run
# the per-sample chain unchanged ({input[0]} either way; the .bai rides
# along for the DAG edge).
input_groups = [
    { pattern = "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam", group_by = "sample" },
]
input = [
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam",
    "{config.out_dir}/bwa/merged_library/{sample}.mLb.clN.sorted.bam.bai",
]
output = [
    "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.pdf",
    "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.raw.txt",
    "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.qcmetrics.txt",
]
description = "MERGED_LIBRARY_DEEPTOOLS_PLOTFINGERPRINT: read coverage fingerprint (single-end: --extendReads fragment_size)"
shell = """
plotFingerprint \\
    --skipZeros \\
    --numberOfSamples {config.fingerprint_bins} \\
    --labels {sample}.mLb.clN \\
    --extendReads {config.fragment_size} \\
    --bamfiles {input[0]} \\
    --plotFile {config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.pdf \\
    --outRawCounts {config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.raw.txt \\
    --outQualityMetrics {config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.qcmetrics.txt \\
    --numberOfProcessors {threads}
"""
when = "!config.paired && !config.skip_plot_fingerprint"

[rules.resources]
threads = 12
memory = "72G"

[rules.environment]
docker = "quay.io/biocontainers/deeptools:3.5.1--py_0"

[[rules]]
name = "multiqc"
input = []
expand_inputs = [
    { pattern = "{config.out_dir}/fastqc/zips/{sample}_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/fastqc/zips/{sample}_trimmed_fastqc.zip", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/trimgalore/logs/{sample}.fastq.gz_trimming_report.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/library/samtools_stats/{sample}.Lb.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/picard_metrics/{sample}.mLb.mkD.sorted.MarkDuplicates.metrics.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.mkD.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bigWig", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.tab", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.raw.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.qcmetrics.txt", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak", variables = { sample = "config.samples_list" } },
    { pattern = "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.annotatePeaks.txt", variables = { sample = "config.samples_list" } },
    # merged-replicate files (config.merged_samples = the base names of the
    # replicate groups, e.g. "S1,S2"); empty by default = no-op. The
    # multiqc scan itself covers these files once they exist — these
    # patterns make the merged-replicate chain a hard dependency so the
    # report never races the merged analysis.
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.stats", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.flagstat", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/samtools_stats/{sample}.mLb.clN.sorted.bam.idxstats", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/bigwig/{sample}.mLb.clN.bigWig", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotprofile/{sample}.mLb.clN.reference_point.plotProfile.tab", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.raw.txt", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/deeptools/plotfingerprint/{sample}.mLb.clN.plotFingerprint.qcmetrics.txt", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.broadPeak", variables = { sample = "config.merged_samples" } },
    { pattern = "{config.out_dir}/bwa/merged_library/macs2/broad_peak/{sample}.mLb.clN_peaks.annotatePeaks.txt", variables = { sample = "config.merged_samples" } },
]
output = ["{config.out_dir}/multiqc/multiqc_report.html"]
description = "MULTIQC: aggregate QC report (upstream MULTIQC local module; multiqc_config.yml staged like upstream so `multiqc -f .` auto-loads it)"
shell = """
ln -sf assets/multiqc_config.yml multiqc_config.yml
multiqc \\
    -f \\
    .

mkdir -p {config.out_dir}/multiqc
# re-run safe: the engine re-runs this rule in place on config invalidation,
# and mv refuses to replace the directories the previous run left behind
rm -rf {config.out_dir}/multiqc/multiqc_data {config.out_dir}/multiqc/multiqc_plots
mv multiqc_report.html {config.out_dir}/multiqc/
mv multiqc_data {config.out_dir}/multiqc/
[ -d multiqc_plots ] && mv multiqc_plots {config.out_dir}/multiqc/
"""
when = "!config.paired && !config.skip_multiqc"

[rules.resources]
threads = 6
memory = "36G"

[rules.environment]
docker = "quay.io/biocontainers/multiqc:1.13--pyhdfd78af_0"
