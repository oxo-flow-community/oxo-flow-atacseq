# Reference preparation — ports nf-core/atacseq 2.1.2 PREPARE_GENOME steps
# that build reference files from a FASTA (config.prepare_reference = true,
# default false). The default path expects pre-built references (README
# "References"); when enabled, these rules generate the BWA index at
# config.bwa_index and the chrom sizes at config.chrom_sizes from
# config.reference. Upstream runs these with save_reference=true publishing to
# outdir/genome/index; this port writes directly to the configured paths.
#
# Also ports upstream KHMER_UNIQUEKMERS (config.macs_gsize = "" — empty means
# auto-estimate, mirroring upstream `if (!params.macs_gsize)`), which writes
# the estimated genome size consumed by macs2_callpeak.

[workflow]
name = "oxo-flow-atacseq-reference"
version = "2.1.2"
description = "Reference preparation branch of the nf-core/atacseq 2.1.2 port (gated by config.prepare_reference; khmer gsize auto-estimate gated by config.macs_gsize == \"\")"

[[rules]]
name = "bwa_index"
input = ["{config.reference}"]
output = [
    "{config.bwa_index}.amb",
    "{config.bwa_index}.ann",
    "{config.bwa_index}.bwt",
    "{config.bwa_index}.pac",
    "{config.bwa_index}.sa",
]
description = "BWA_INDEX: build the BWA index for config.reference at config.bwa_index (upstream BWA_INDEX)"
shell = """
mkdir -p $(dirname {config.bwa_index})
bwa \\
    index \\
    -p {config.bwa_index} \\
    {config.reference}
"""
when = "config.prepare_reference && config.aligner == 'bwa'"

[rules.resources]
threads = 6
memory = "36G"

# Same mulled bwa+samtools build as bwa_mem: the .amb format written by some
# bwa 0.7.17 biocontainer builds is not readable by this one (live-verified
# "Parse error reading *.amb" when ref::bwa_index used its own image).
[rules.environment]
docker = "quay.io/biocontainers/mulled-v2-fe8faa35dbf6dc65a0f7f5d4ea12e31a79f73e40:219b6c272b25e7e642ae3ff0bf0c5c81a5135ab4-0"

[[rules]]
name = "custom_getchromsizes"
input = ["{config.reference}"]
output = [
    "{config.reference}.fai",
    "{config.chrom_sizes}",
]
description = "CUSTOM_GETCHROMSIZES: samtools faidx + chrom sizes from config.reference (upstream CUSTOM_GETCHROMSIZES; point config.chrom_sizes at the generated file)"
shell = """
samtools faidx {config.reference}
mkdir -p $(dirname {config.chrom_sizes})
cut -f 1,2 {config.reference}.fai > {config.chrom_sizes}
"""
when = "config.prepare_reference"

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/samtools:1.16.1--h6899075_1"

[[rules]]
name = "khmer_uniquekmers"
# Upstream KHMER_UNIQUEKMERS (prepare_genome.nf): when params.macs_gsize is
# empty, estimate the genome size from the FASTA with khmer unique-kmers.py at
# params.read_length, and feed the result to MACS2_CALLPEAK. Here: activated by
# config.macs_gsize == "" (empty = auto-estimate); consumed via depends_on by
# macs2_callpeak, which cats the written file when the gate is open.
input = ["{config.reference}"]
output = ["{config.out_dir}/genome/kmers.txt"]
description = "KHMER_UNIQUEKMERS: estimate genome size with khmer unique-kmers.py at config.read_length (upstream KHMER_UNIQUEKMERS; activated by config.macs_gsize = \"\")"
shell = """
mkdir -p $(dirname {config.out_dir}/genome/kmers.txt)
unique-kmers.py \\
    -k {config.read_length} \\
    -R report.txt \\
    {config.reference}

grep ^number report.txt | sed 's/^.*:.[[:blank:]]//g' > {config.out_dir}/genome/kmers.txt
"""
when = "config.macs_gsize == ''"

[rules.resources]
threads = 1
memory = "6G"

[rules.environment]
docker = "quay.io/biocontainers/khmer:3.0.0a3--py37haa7609a_2"
